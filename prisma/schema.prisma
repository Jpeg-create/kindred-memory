// KindredMemory — Prisma schema
//
// Datasource uses the "cockroachdb" provider — Prisma DOES have a native
// provider for CockroachDB (an earlier version of this comment claimed
// otherwise and had us on the "postgresql" provider instead; that was
// wrong — Prisma itself threw a runtime error during setup directing us
// to switch to "cockroachdb", which is what's actually in use now).
//
// Prisma 7 moved the connection URL out of this file and into
// prisma.config.ts at the repo root (schema-level `url = env(...)` is
// rejected by `prisma validate` as of prisma@7.9.1) — see that file, and
// src/lib/prisma.ts for how PrismaClient is instantiated with a driver
// adapter, which Prisma 7 now requires. `@prisma/adapter-pg` is still the
// correct adapter even with the cockroachdb provider, since CockroachDB
// is wire-compatible with Postgres at the driver level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model FamilyMember {
  id          String   @id @default(uuid())
  name        String
  relationship String  // e.g. "daughter", "son"
  contactInfo String?
  createdAt   DateTime @default(now())

  addedMemories Memory[] @relation("MemoryAddedBy")
}

model Elder {
  id             String   @id @default(uuid())
  name           String
  whatsappNumber String   @unique
  createdAt      DateTime @default(now())

  memories          Memory[]
  conversationTurns ConversationTurn[]
}

model Memory {
  id                     String   @id @default(uuid())
  elderId                String
  elder                  Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
  content                String
  source                 MemorySource
  addedByFamilyMemberId  String?
  addedByFamilyMember    FamilyMember? @relation("MemoryAddedBy", fields: [addedByFamilyMemberId], references: [id])
  createdAt              DateTime @default(now())

  // A real CockroachDB vector index (`memory_embedding_cosine_idx`) is
  // LIVE on this column on the production cluster — created, applied, and
  // confirmed via SHOW INDEXES. See
  // prisma/manual-sql/create-vector-index.sql for the exact SQL (a
  // reference/runbook now, not a to-do) — not a Prisma migration, since
  // this project uses `db push`, not migration history (see
  // README-setup.md). It uses elderId as a prefix column for
  // cosine-distance search scoped per elder, matching
  // src/recall/index.ts's existing query shape exactly (no code change
  // was needed there — see the comment in that file).
  //
  // Two things worth knowing if you're reading this later:
  //
  // 1. CockroachDB's own sources disagreed on cosine-distance support:
  //    the official Vector Indexes docs list `vector_cosine_ops` as
  //    valid, but a CockroachDB engineering blog post described cosine as
  //    still "on the roadmap." Rather than trust either blindly, this was
  //    tested directly against this cluster with a throwaway index before
  //    creating the real one — cosine works fine here. Docs and blog
  //    posts can be stale relative to what's actually shipped; direct
  //    empirical testing against the live cluster is what actually
  //    settled it.
  //
  // 2. `EXPLAIN` on a realistic recall-shaped query (filtered by elderId,
  //    ordered by cosine distance, LIMIT 5) shows the planner currently
  //    choosing the plain B-tree `Memory_elderId_idx` (full scan + sort)
  //    over the new vector index — NOT a bug. At the current tiny test
  //    data volume, a full scan genuinely is cheaper than an
  //    approximate-nearest-neighbor lookup, and CockroachDB's cost-based
  //    optimizer picks it correctly. The vector index will get selected
  //    naturally once real data volume grows past that crossover point.
  //    (EXPLAIN also printed an "index recommendation" for that one tiny
  //    test query specifically — not something to act on; it's about
  //    optimizing that single small-scale query, unrelated to the actual
  //    goal of using the vector index at production-realistic volume.)
  //
  // Everything else here is done and confirmed working end to end against
  // the real cluster: ingest (src/ingest/index.ts) and recall
  // (src/recall/index.ts) both read/write this column via raw SQL
  // ($queryRaw / $executeRaw with `::vector` casts) — Prisma Client still
  // has no typed API for Unsupported() columns, so that raw-SQL path is
  // permanent, not a placeholder. Embeddings come from Gemini's
  // `gemini-embedding-2` model at 768 dimensions (see
  // src/lib/embeddings.ts).
  embedding Unsupported("vector(768)")?

  @@index([elderId])
}

enum MemorySource {
  family_added
  conversation_derived
}

model ConversationTurn {
  id        String            @id @default(uuid())
  elderId   String
  elder     Elder             @relation(fields: [elderId], references: [id], onDelete: Cascade)
  role      ConversationRole
  content   String
  createdAt DateTime          @default(now())

  @@index([elderId])
}

enum ConversationRole {
  elder
  companion
}

model AuditLogEntry {
  id        String     @id @default(uuid())
  actorType ActorType
  actorId   String?
  action    String     // e.g. "memory_added", "memory_deleted", "memory_viewed"
  targetId  String?    // e.g. which Memory
  createdAt DateTime   @default(now())
}

enum ActorType {
  family
  system
}
