# Connection string for the CockroachDB Cloud cluster.
# Get this from the CockroachDB Cloud console: your cluster -> "Connect" ->
# "Connection string" tab. Copy it as-is (includes sslmode=verify-full and
# a cluster-routing param) and paste it into your local .env — never commit
# the real value.
DATABASE_URL="postgresql://<username>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full&options=--cluster%3D<cluster-name>"

# API key for Google's Gemini API, used to generate memory embeddings
# (gemini-embedding-2, see src/lib/embeddings.ts). Get this from
# https://aistudio.google.com/apikey — paste it into your local .env, never
# commit the real value.
GEMINI_API_KEY=

